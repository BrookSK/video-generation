# Copie para infra/compose/.env e preencha. Nunca versione o .env.

# Senha do PostgreSQL; use só letras, dígitos, "-" e "_" (entra na DATABASE_URL da api).
POSTGRES_PASSWORD=
# Token que o worker usa em /internal/v1.
WORKER_TOKEN=
# production (padrão) ou development.
APP_ENV=
# Duração do lease de um item da fila, em segundos (padrão 120).
LEASE_SECONDS=
# Intervalo da varredura de leases vencidos, em segundos (padrão 30).
SWEEP_INTERVAL_SECONDS=
# Porta local da api no docker-compose.dev.yml (padrão 8000, só em 127.0.0.1).
API_PORT=
# Porta local do painel nos overrides dev e cpu (padrão 8088, só em 127.0.0.1).
PANEL_PORT=
# Tipos de tarefa: base GPU video,asset_prepare; overrides CPU/dev asset_prepare.
WORKER_KINDS=
# Identidade estável do worker de vídeo (padrão gpu-01).
WORKER_ID=
# URL interna da API (base http://api:8000); duas VPS usam túnel, nunca endpoint público.
API_URL=
# Endereço do site no Caddyfile (padrão :80, HTTP sem domínio).
SITE_ADDRESS=
# Caminho absoluto dos pesos no host, montado em /models só leitura no piloto e no worker.
# Obrigatório no docker-compose.pilot.yml; o worker usa /srv/avatar/models e o
# docker-compose.dev.yml usa models/ na raiz do repositório quando vazio.
# MODELS_DIR=
# Só docker-compose.pilot.yml: caminho absoluto das entradas e saídas do piloto (montado em /pilot).
# PILOT_DIR=
